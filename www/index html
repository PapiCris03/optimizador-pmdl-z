const persp=(f,a,n,fr)=>{const t=1/Math.tan(f/2);return new Float32Array([t/a,0,0,0,0,t,0,0,0,0,(fr+n)/(n-fr),-1,0,0,2*fr*n/(n-fr),0])};
function initGL(){
  const cv=$('cv');gl=cv.getContext('webgl',{antialias:true});if(!gl){$('vi').textContent='Este navegador no admite WebGL.';return false}
  const sh=(t,s)=>{const o=gl.createShader(t);gl.shaderSource(o,s);gl.compileShader(o);return o};
  prog=gl.createProgram();
  gl.attachShader(prog,sh(gl.VERTEX_SHADER,'attribute vec3 p;attribute vec2 t;uniform mat4 mvp;uniform float ps;varying vec2 vt;void main(){gl_Position=mvp*vec4(p,1.);gl_PointSize=ps;vt=t;}'));
  gl.attachShader(prog,sh(gl.FRAGMENT_SHADER,'precision mediump float;varying vec2 vt;uniform sampler2D s;uniform float ht,wr;uniform vec3 uc;void main(){vec4 c=ht>.5?texture2D(s,vt):vec4(.72,.72,.76,1.);if(c.a<.5)discard;gl_FragColor=wr>.5?vec4(uc,1.):vec4(c.rgb,1.);}'));
  gl.linkProgram(prog);gl.useProgram(prog);
  for(const n of ['p','t'])L[n]=gl.getAttribLocation(prog,n);
  for(const n of ['mvp','ht','wr','ps','uc'])L[n]=gl.getUniformLocation(prog,n);
  gl.enable(gl.DEPTH_TEST);return true;
}
function mk(arr){const b=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,b);gl.bufferData(gl.ARRAY_BUFFER,arr,gl.STATIC_DRAW);return b}
function use(attr,b,size){gl.bindBuffer(gl.ARRAY_BUFFER,b);gl.enableVertexAttribArray(attr);gl.vertexAttribPointer(attr,size,gl.FLOAT,false,0,0)}
function setMesh(mm){
  if(mesh&&mesh.bp)for(const k of ['bp','bt','bw','bbl','bbp'])gl.deleteBuffer(mesh[k]);
  mesh=mm;const e=new Float32Array(mm.tris*18);
  for(let i=0;i<mm.tris;i++)for(let k=0;k<3;k++){const a=i*9+k*3,b=i*9+((k+1)%3)*3,o=i*18+k*6;for(let q=0;q<3;q++){e[o+q]=mm.pos[a+q];e[o+3+q]=mm.pos[b+q]}}
  wireBuf=e;mm.bp=mk(mm.pos);mm.bt=mk(mm.uv);mm.bw=mk(e);mm.bbl=mk(mm.bones.lines);mm.bbp=mk(mm.bones.pts);
  cam.c=[0,1,2].map(a=>(mm.mn[a]+mm.mx[a])/2);const sz=Math.max(mm.mx[0]-mm.mn[0],mm.mx[1]-mm.mn[1],mm.mx[2]-mm.mn[2]);cam.dist=sz*1.6;
  ui();draw();
}
function ui(){
  if(!cur||!mesh)return;$('vA').classList.toggle('on',mode==='A');$('vB').classList.toggle('on',mode==='B');$('vW').classList.toggle('on',wire);$('vT').classList.toggle('on',showTex);$('vH').classList.toggle('on',showBones);
  const by=mode==='A'?cur.buf.byteLength:cur.out.length;
  $('vi').textContent='Mostrando: '+(mode==='A'?'ORIGINAL':'OPTIMIZADO')+' · '+fmt(mesh.tris)+' triángulos · '+fmt(by)+' bytes'+(showBones?' · '+mesh.bones.n+' huesos':'')+(!showTex?' · sin textura':(texs.def?'':' · sin textura: elige el PNG'));
}
function draw(){
  if(!gl)return;const cv=$('cv'),dpr=window.devicePixelRatio||1,w=Math.round(cv.clientWidth*dpr),h2=Math.round(cv.clientHeight*dpr);
  if(cv.width!==w||cv.height!==h2){cv.width=w;cv.height=h2}
  gl.viewport(0,0,w,h2);gl.clearColor(.027,.023,.039,1);gl.clear(gl.COLOR_BUFFER_BIT|gl.DEPTH_BUFFER_BIT);
  if(!mesh)return;
  const R=mul(rotX(cam.pitch),rotY(cam.yaw)),mv=mul(trans(0,0,-cam.dist),mul(R,trans(-cam.c[0],-cam.c[1],-cam.c[2])));
  gl.uniformMatrix4fv(L.mvp,false,mul(persp(0.8,w/h2,cam.dist/50,cam.dist*10),mv));
  if(wire){gl.uniform1f(L.wr,1);gl.uniform1f(L.ht,0);gl.uniform1f(L.ps,1);gl.uniform3f(L.uc,1,.48,.09);use(L.p,mesh.bw,3);gl.disableVertexAttribArray(L.t);gl.drawArrays(gl.LINES,0,mesh.tris*6)}
  else{gl.uniform1f(L.wr,0);use(L.p,mesh.bp,3);use(L.t,mesh.bt,2);
    for(const r of mesh.ranges){const t=showTex?(texs[r.mat]||texs.def):null;gl.uniform1f(L.ht,t?1:0);if(t)gl.bindTexture(gl.TEXTURE_2D,t);gl.drawArrays(gl.TRIANGLES,r.start,r.count)}}
  if(showBones&&mesh.bones.n){gl.disable(gl.DEPTH_TEST);gl.uniform1f(L.wr,1);gl.uniform1f(L.ht,0);gl.disableVertexAttribArray(L.t);
    if(mesh.bones.lines.length){gl.uniform1f(L.ps,1);gl.uniform3f(L.uc,1,.55,.1);use(L.p,mesh.bbl,3);gl.drawArrays(gl.LINES,0,mesh.bones.lines.length/3)}
    gl.uniform1f(L.ps,7);gl.uniform3f(L.uc,1,.92,.25);use(L.p,mesh.bbp,3);gl.drawArrays(gl.POINTS,0,mesh.bones.n);gl.uniform1f(L.ps,1);gl.enable(gl.DEPTH_TEST)}
}
const redraw=()=>{if(dirty)return;dirty=true;requestAnimationFrame(()=>{dirty=false;draw()})};
function viewerLoad(){
  if(!gl&&!initGL())return;if(loadedOnce){for(const k in texs)if(texs[k])gl.deleteTexture(texs[k]);texs={}}loadedOnce=true;mode='A';$('vB').disabled=true;setMesh(buildMesh(cur.buf,cur.m,true));
}
function viewerOpt(){$('vB').disabled=false}
$('vA').onclick=()=>{if(cur){mode='A';setMesh(buildMesh(cur.buf,cur.m,true))}};
$('vB').onclick=()=>{if(cur&&cur.out){mode='B';const ab=cur.out.buffer;setMesh(buildMesh(ab,parsePmdl(ab),true))}};
$('vW').onclick=()=>{wire=!wire;ui();redraw()};
$('vT').onclick=()=>{showTex=!showTex;ui();redraw()};
$('vH').onclick=()=>{showBones=!showBones;ui();redraw()};
$('vt').onchange=e=>{
  if(!gl)return;const files=[...e.target.files];if(!files.length)return;
  for(const k in texs)if(texs[k])gl.deleteTexture(texs[k]);texs={};
  files.forEach((f,i)=>{const n=(f.name.match(/(\d+)\.png$/i)||[])[1],img=new Image();
    img.onload=()=>{const t=gl.createTexture();gl.bindTexture(gl.TEXTURE_2D,t);gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,gl.RGBA,gl.UNSIGNED_BYTE,img);
      gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,gl.LINEAR);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MAG_FILTER,gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S,gl.CLAMP_TO_EDGE);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);
      if(n)texs[parseInt(n.slice(-2),10)-1]=t;if(i===0||n==='0101'||!texs.def)texs.def=t;
      URL.revokeObjectURL(img.src);ui();redraw()};
    img.src=URL.createObjectURL(f)});
  e.target.value='';
};
{const cv=$('cv'),ptr=new Map();let pd=0;
 cv.onpointerdown=e=>{cv.setPointerCapture(e.pointerId);ptr.set(e.pointerId,[e.clientX,e.clientY]);if(ptr.size===2){const [a,b]=[...ptr.values()];pd=Math.hypot(a[0]-b[0],a[1]-b[1])}};
 cv.onpointerup=cv.onpointercancel=e=>ptr.delete(e.pointerId);
 cv.onpointermove=e=>{if(!ptr.has(e.pointerId))return;const o=ptr.get(e.pointerId);ptr.set(e.pointerId,[e.clientX,e.clientY]);
   if(ptr.size===1){cam.yaw+=(e.clientX-o[0])*0.01;cam.pitch=Math.max(-1.5,Math.min(1.5,cam.pitch+(e.clientY-o[1])*0.01))}
   else if(ptr.size===2){const [a,b]=[...ptr.values()],d=Math.hypot(a[0]-b[0],a[1]-b[1]);if(pd)cam.dist=Math.max(0.05,cam.dist*pd/d);pd=d}
   redraw()};
 cv.onwheel=e=>{e.preventDefault();cam.dist*=1+e.deltaY*0.001;redraw()};
 window.addEventListener('resize',redraw)}
if(initGL()){$('vi').textContent='Carga un pmdl para ver el modelo. Si quieres, elige antes el PNG de textura.';draw()}
$('sm').onclick=()=>{
  if(!cur)return;const {buf,m,name}=cur,eps=parseFloat($('lv').value);
  $('rtr').textContent='Simplificando…';$('dl').innerHTML='';kiProgress(35,'Modo peligro: simplificando malla...','warn');
  setTimeout(()=>{try{
    const {out,st}=simplify(buf,m,eps),m2=parsePmdl(out.buffer),pc=(100*(1-out.length/m.size)).toFixed(1);
    if(m2.issues.length)throw new Error('el resultado no pasó la comprobación de estructura');
    cur.out=out;viewerOpt();
    $('rtr').innerHTML='<span class="ok">Simplificado al '+(eps*100).toFixed(1).replace('.',',')+' % de error máximo.</span><br>'+fmt(m.size)+' → '+fmt(out.length)+' bytes ('+(pc>=0?'−':'+')+Math.abs(pc)+' %)<br>Triángulos: '+fmt(st.tb)+' → '+fmt(st.ta)+'<br>Regiones: '+fmt(st.rb)+' → '+fmt(st.ra)+'<br>Compáralo con el botón Optimizado del visor antes de usarlo.';
    const url=URL.createObjectURL(new Blob([out],{type:'application/octet-stream'}));
    $('dl').innerHTML='<p><a download="'+name.replace(/\.pmdl$/i,'')+'_simplificado.pmdl" href="'+url+'">Descargar pmdl simplificado</a></p>';
    kiProgress(100,'Simplificación completada.');
  }catch(e){$('rtr').innerHTML='<span class="bad">Error: '+e.message+'</span>';kiProgress(0,'Error durante la simplificación.','warn')}},30);
};
$('rep').onclick=()=>{
  if(!cur)return;const {m,a,name}=cur;
  kiProgress(70,'Generando informe...');
  const t=['Informe pmdl: '+name,'bytes '+m.size,'ver '+m.ver+' huesos '+m.bones+' materiales '+m.mats+' bloques '+m.nb,
   'vertices '+a.verts+' ('+a.vbytes+' B) cabeceras '+a.rows+' B','tiras '+a.tris+' reales '+a.real,
   'formatos '+JSON.stringify(a.hist),'avisos '+m.issues.length,
   ...m.blocks.map(x=>'blk '+x.i+' mat '+x.mat+' bytes '+x.size+' reg '+x.regs.length+' v '+x.v+' tri '+x.r)].join('\n');
  (navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(()=>{$('rtr').textContent='Informe copiado.';kiProgress(100,'Informe copiado.')},()=>{$('dl').innerHTML='<pre>'+t+'</pre>';kiProgress(100,'Informe generado.')});
};

document.querySelectorAll('.tabs button').forEach(btn=>{
  btn.onclick=()=>{
    const cards=document.querySelectorAll('.layout > .card');
    const target=Number(btn.dataset.go);
    if(cards[target])cards[target].scrollIntoView({behavior:'smooth',block:'start'});
  };
});
}
