<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#07060a">
<title>Optimizador PMDL Z · Tenkaichi Tag Team</title>
<style>
:root{
  --bg:#07060a;--panel:#12100f;--panel2:#1a1614;--line:#3a2a17;
  --orange:#ff7a18;--orange2:#ff9a3c;--gold:#ffc93c;--red:#ff3b3b;
  --text:#f5efe6;--mut:#b8a894;--ok:#ffc93c;--bad:#ff6b6b;
}
*{box-sizing:border-box}
html,body{margin:0}
body{
  min-height:100vh;color:var(--text);
  font:15px/1.5 "Segoe UI",system-ui,sans-serif;
  background:
    radial-gradient(circle at 12% 8%,rgba(255,122,24,.18),transparent 45%),
    radial-gradient(circle at 88% 92%,rgba(255,201,60,.10),transparent 45%),
    linear-gradient(180deg,#07060a,#0d0a08);
}
.app{max-width:1500px;margin:0 auto;padding:16px}

header{
  display:flex;align-items:center;gap:14px;
  padding:16px 18px;margin-bottom:14px;
  border:1px solid rgba(255,122,24,.25);border-radius:18px;
  background:
    linear-gradient(90deg,rgba(255,122,24,.13),transparent 60%),
    linear-gradient(180deg,#15100d,#0a0806);
  box-shadow:0 0 35px rgba(255,122,24,.12);
}
.emblem{
  width:58px;height:58px;flex:0 0 auto;display:grid;place-items:center;
  font-size:32px;font-weight:900;color:#fff7e6;
  background:radial-gradient(circle at 35% 30%,#2a2a2a,#0a0a0a 70%);
  border:3px solid var(--orange);border-radius:50%;
  box-shadow:0 0 18px rgba(255,122,24,.55),inset 0 0 14px rgba(255,122,24,.25);
  text-shadow:0 0 10px rgba(255,201,60,.8),0 2px 0 rgba(0,0,0,.6);
}
h1{
  margin:0;font-family:Impact,"Arial Black",sans-serif;
  font-size:clamp(22px,4vw,34px);letter-spacing:.06em;text-transform:uppercase;
  color:var(--gold);
  text-shadow:0 0 14px rgba(255,122,24,.6),0 0 35px rgba(255,122,24,.25);
}
header p{margin:4px 0 0;color:var(--mut);font-size:11px;letter-spacing:.12em;text-transform:uppercase}
.status{
  margin-left:auto;display:flex;align-items:center;gap:8px;
  padding:8px 13px;font-size:11px;color:var(--gold);white-space:nowrap;
  border:1px solid rgba(255,201,60,.3);border-radius:999px;background:rgba(255,201,60,.07);
}
.status i{width:9px;height:9px;border-radius:50%;background:var(--gold);box-shadow:0 0 10px var(--gold);animation:ki 1.3s infinite alternate}
@keyframes ki{from{opacity:.4;transform:scale(.8)}to{opacity:1;transform:scale(1.15)}}

.layout{display:grid;grid-template-columns:330px minmax(0,1fr) 330px;gap:14px;align-items:start}
.card{
  background:linear-gradient(180deg,rgba(26,22,20,.96),rgba(12,10,8,.96));
  border:1px solid rgba(255,122,24,.22);border-radius:18px;overflow:hidden;
  box-shadow:0 18px 45px rgba(0,0,0,.55),inset 0 0 35px rgba(255,122,24,.05);
}
.card::before{content:"";display:block;height:3px;background:linear-gradient(90deg,transparent,var(--orange),var(--gold),transparent)}
.card-body{padding:15px}
h2{margin:0 0 12px;font-family:Impact,"Arial Black",sans-serif;font-size:14px;letter-spacing:.1em;text-transform:uppercase;color:var(--orange2)}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}

button,label.b{
  border:1px solid rgba(255,122,24,.55);
  background:linear-gradient(180deg,#241708,#120c07);
  color:var(--text);border-radius:12px;padding:11px 14px;
  font:700 13px/1 Impact,"Arial Black",sans-serif;
  letter-spacing:.07em;text-transform:uppercase;cursor:pointer;transition:.18s ease;
}
button:hover,label.b:hover{
  border-color:var(--orange);color:#fff;
  background:linear-gradient(180deg,#331c08,#1a1006);
  box-shadow:0 0 18px rgba(255,122,24,.35);transform:translateY(-1px);
}
button:active{transform:translateY(1px)}
button:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none}
button.primary,label.b{
  color:#140a02;font-weight:900;
  background:linear-gradient(180deg,var(--orange),#b34d00);
  border-color:var(--gold);box-shadow:0 0 22px rgba(255,122,24,.4);
}
button.primary:hover,label.b:hover{background:linear-gradient(180deg,var(--gold),var(--orange));box-shadow:0 0 32px rgba(255,201,60,.55)}
button.danger{color:#ffd7d7;background:linear-gradient(180deg,#4a0f0f,#210606);border-color:rgba(255,59,59,.6)}
button.danger:hover{border-color:var(--red);box-shadow:0 0 20px rgba(255,59,59,.35)}
button.ghost{background:transparent;color:var(--orange2);border-color:rgba(255,122,24,.35)}
button.ghost.on{background:linear-gradient(180deg,var(--orange),#b34d00);color:#140a02;border-color:var(--gold)}
input[type=file]{display:none}
select{
  padding:10px 12px;color:var(--text);background:#0c0a08;
  border:1px solid var(--line);border-radius:10px;
}
select:focus{outline:none;border-color:var(--orange)}

.viewer{position:relative;border:1px solid rgba(255,122,24,.18);border-radius:14px;overflow:hidden;
  background:radial-gradient(circle at center,rgba(255,122,24,.07),transparent 60%),#08070a}
#cv{width:100%;height:520px;display:block;touch-action:none;background:transparent}
.viewer-tools{position:absolute;top:12px;left:12px;right:12px;display:flex;flex-wrap:wrap;gap:8px;z-index:3}
.viewer-tools button{width:auto;margin:0;padding:9px 12px;font-size:11px}
.viewer-info{position:absolute;left:12px;right:12px;bottom:10px;margin:0;color:var(--mut);font-size:12px;text-shadow:0 2px 8px #000}

.metrics{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.metric{padding:12px;border:1px solid rgba(255,122,24,.18);border-radius:12px;background:#0c0a08}
.metric span{display:block;font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.08em}
.metric b{display:block;margin-top:4px;font-size:18px;color:var(--gold);font-variant-numeric:tabular-nums}

dl{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;margin:0}
dt{color:var(--mut);font-size:12px;text-transform:uppercase;letter-spacing:.06em}
dd{margin:0;font-variant-numeric:tabular-nums}
.sc{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:13px;font-variant-numeric:tabular-nums}
th,td{padding:9px 10px;text-align:right;border-bottom:1px solid rgba(255,122,24,.12);white-space:nowrap}
th{background:linear-gradient(90deg,#2a1807,#171008);color:var(--gold);text-transform:uppercase;letter-spacing:.08em;font-size:11px}
th:first-child,td:first-child{text-align:left}
tr:hover td{background:rgba(255,122,24,.06)}
.ok{color:var(--ok)}.bad{color:var(--bad)}
pre{white-space:pre-wrap;font-size:12px;margin:10px 0 0;color:var(--mut)}
#rtr{margin:10px 0 0;color:var(--mut);font-size:13px}
#fn{margin:10px 0 0;color:var(--mut)}
#dl a{
  display:inline-block;margin-top:10px;padding:11px 16px;
  color:#140a02;font:900 13px/1 Impact,"Arial Black",sans-serif;
  letter-spacing:.07em;text-transform:uppercase;text-decoration:none;
  background:linear-gradient(180deg,var(--gold),var(--orange));
  border:1px solid var(--gold);border-radius:12px;
  box-shadow:0 0 22px rgba(255,201,60,.4);
}
.progress{height:10px;margin-top:14px;border-radius:999px;overflow:hidden;background:#0a0806;border:1px solid rgba(255,122,24,.25)}
.progress i{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--orange),var(--gold));box-shadow:0 0 18px rgba(255,122,24,.6);transition:width .3s ease}
.alert{display:none;margin-top:12px;padding:12px;border-radius:12px;font-size:13px}
.alert.warn{display:block;color:#ffd7d7;border:1px solid rgba(255,59,59,.45);background:rgba(255,59,59,.08)}
.alert.ok{display:block;color:#2b1a00;font-weight:700;background:linear-gradient(90deg,var(--gold),var(--orange))}

.tabs{display:none;position:sticky;bottom:0;z-index:9;margin-top:14px;padding:10px;gap:8px;
  background:rgba(10,8,6,.95);border:1px solid rgba(255,122,24,.22);border-radius:16px;backdrop-filter:blur(10px)}
.tabs button{margin:0;padding:13px 8px;font-size:11px}

@media(max-width:1150px){
  .layout{grid-template-columns:1fr}
  #cv{height:420px}
  .tabs{display:grid;grid-template-columns:repeat(4,1fr)}
}
@media(max-width:560px){
  .app{padding:10px}
  header{flex-wrap:wrap}
  .status{margin-left:0;width:100%;justify-content:center}
  .metrics{grid-template-columns:1fr}
  .tabs{grid-template-columns:repeat(2,1fr)}
  .viewer-tools button{padding:10px;font-size:10px}
}
</style>
</head>
<body>

<div class="app">

  <header>
    <div class="emblem">悟</div>
    <div>
      <h1>Optimizador PMDL Z</h1>
      <p>Tenkaichi Tag Team · Laboratorio de combate</p>
    </div>
    <div class="status"><i></i><span>Modo local activo</span></div>
  </header>

  <div class="layout">

    <section class="card">
      <div class="card-body">
        <h2>Cargar modelo</h2>
        <label class="b" style="width:100%;text-align:center">
          Elegir archivo .pmdl
          <input id="f" type="file">
        </label>
        <p id="fn">Ningún archivo</p>

        <h2 style="margin-top:20px">Optimización</h2>
        <label style="display:block;margin:0 0 6px;color:var(--mut);font-size:12px;text-transform:uppercase;letter-spacing:.08em">Nivel de simplificación</label>
        <select id="lv" style="width:100%">
          <option value="0.005">Suave · 0,5 %</option>
          <option value="0.01" selected>Medio · 1 %</option>
          <option value="0.02">Fuerte · 2 %</option>
        </select>

        <button id="rt" class="ghost" disabled style="width:100%">Probar reescritura</button>
        <button id="op" class="primary" disabled style="width:100%">Optimizar seguro</button>
        <button id="sm" class="danger" disabled style="width:100%">Simplificar con pérdida</button>
        <button id="rep" class="ghost" disabled style="width:100%">Copiar informe</button>

        <div class="progress"><i id="bar"></i></div>
        <div id="alert" class="alert"></div>
        <p id="rtr"></p>
        <div id="dl"></div>
      </div>
    </section>

    <section class="card">
      <div class="card-body">
        <h2>Visor de combate</h2>
        <div class="viewer">
          <div class="viewer-tools">
            <button id="vA" class="ghost" disabled>Original</button>
            <button id="vB" class="ghost" disabled>Optimizado</button>
            <button id="vW" class="ghost">Alámbrico</button>
            <button id="vT" class="ghost on">Textura</button>
            <button id="vH" class="ghost">Huesos</button>
            <label class="b" style="width:auto">Texturas PNG<input id="vt" type="file" accept="image/png" multiple></label>
          </div>
          <canvas id="cv"></canvas>
          <p id="vi" class="viewer-info"></p>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-body">
        <h2>Análisis</h2>
        <div id="sum"></div>

        <h2 style="margin-top:20px">Bloques</h2>
        <div class="sc">
          <table id="tb">
            <tr><th>Bloque</th><th>Mat.</th><th>Bytes</th><th>Regiones</th><th>Vértices</th><th>Triáng. reales</th></tr>
          </table>
        </div>
      </div>
    </section>

  </div>

  <nav class="tabs">
    <button data-go="0">Archivo</button>
    <button data-go="1">Visor</button>
    <button data-go="2">Análisis</button>
    <button data-go="3">Descargas</button>
  </nav>

</div>

<script>
// ---------- núcleo (lectura y reescritura de pmdl) ----------
function stride(vt){
  const tex=vt&3,col=(vt>>2)&7,nor=(vt>>5)&3,pos=(vt>>7)&3,wf=(vt>>9)&3,wn=((vt>>14)&7)+1;
  const sz=[0,1,2,4];let off=0,al=1;
  const put=(s,c)=>{if(!s)return;off=Math.ceil(off/s)*s+s*c;al=Math.max(al,s)};
  if(wf)put(sz[wf],wn);if(tex)put(sz[tex],2);if(col)put(col==7?4:2,1);
  if(nor)put(sz[nor],3);if(pos)put(sz[pos],3);
  return {st:Math.ceil(off/al)*al,wn:wf?wn:0};
}
function parsePmdl(buf){
  const dv=new DataView(buf),u32=o=>dv.getUint32(o,true),u16=o=>dv.getUint16(o,true);
  const b=new Uint8Array(buf);
  if(String.fromCharCode(b[0],b[1],b[2],b[3])!=='pMdl')throw new Error('No es un pmdl (falta la firma pMdl)');
  const m={size:buf.byteLength,ver:u32(4),bones:u32(8),mats:u32(0x54),nb:u32(0x5c),tb:u32(0x60),
    bbox:[dv.getFloat32(0x40,true),dv.getFloat32(0x44,true),dv.getFloat32(0x48,true)],blocks:[],issues:[]};
  for(let i=0;i<m.nb;i++){
    const e=m.tb+i*32,blk={i,mat:u16(e),off:u32(e+4),size:u32(e+8),regs:[]};
    if(blk.off+blk.size>m.size){m.issues.push('Bloque '+i+' fuera del archivo');m.blocks.push(blk);continue}
    const n=u32(blk.off),rows=[];
    for(let k=0;k<=n+1;k++){const o=blk.off+16*k;rows.push({o:u32(o),c:u16(o+4),a:u16(o+6),cmd:u32(o+12),b:u32(o+8)})}
    for(let j=0;j<n;j++){
      const vt=rows[j].cmd,start=rows[j+1].o,cnt=rows[j].c,end=j+2<=n?rows[j+2].o:null;
      if((vt>>>24)!==0x12){m.issues.push('Bloque '+i+' región '+j+': comando de formato inesperado');continue}
      const s=stride(vt&0xffffff);
      if(end!==null?end-start!==cnt*s.st:(blk.size-(start+cnt*s.st)<0||blk.size-(start+cnt*s.st)>=32))
        m.issues.push('Bloque '+i+' región '+j+': los tamaños no cuadran');
      blk.regs.push({start,cnt,vt,st:s.st,wn:s.wn,a:rows[j].a,b:rows[j].b});
    }
    m.blocks.push(blk);
  }
  return m;
}
function analyze(buf,m){
  const b=new Uint8Array(buf);
  let verts=0,vbytes=0,tris=0,real=0,rows=0;const hist={};
  for(const blk of m.blocks){
    blk.v=0;blk.t=0;blk.r=0;rows+=(blk.regs.length+2)*16;
    for(const r of blk.regs){
      blk.v+=r.cnt;verts+=r.cnt;vbytes+=r.cnt*r.st;
      const k=r.st+' B ('+r.wn+' pesos)';hist[k]=(hist[k]||0)+r.cnt;
      const key=[];
      for(let q=0;q<r.cnt;q++){const o=blk.off+r.start+q*r.st;key.push(Array.prototype.join.call(b.subarray(o,o+r.st),','))}
      for(let q=0;q+2<r.cnt;q++){tris++;blk.t++;
        if(key[q]!==key[q+1]&&key[q]!==key[q+2]&&key[q+1]!==key[q+2]){real++;blk.r++}}
    }
  }
  return {verts,vbytes,tris,real,rows,hist};
}
function rebuild(buf,m,newPayloads){
  const b=new Uint8Array(buf);
  const first=Math.min(...m.blocks.map(x=>x.off));
  const pay=m.blocks.map((x,i)=>newPayloads&&newPayloads[i]?newPayloads[i]:b.subarray(x.off,x.off+x.size));
  const last=Math.max(...m.blocks.map(x=>x.off+x.size)),tail=b.subarray(last);
  const total=first+pay.reduce((s,p)=>s+p.length,0)+tail.length;
  const out=new Uint8Array(total);out.set(b.subarray(0,first),0);
  const dv=new DataView(out.buffer);let pos=first;
  pay.forEach((p,i)=>{out.set(p,pos);dv.setUint32(m.tb+i*32+4,pos,true);dv.setUint32(m.tb+i*32+8,p.length,true);pos+=p.length});
  out.set(tail,pos);
  return out;
}
function same(a,b){if(a.length!==b.length)return false;for(let i=0;i<a.length;i++)if(a[i]!==b[i])return false;return true}

// ---------- optimización sin pérdida ----------
function writeBlock(regs){
  const N=regs.length,hdr=Math.ceil((N+1)*16/64)*64,data=regs.reduce((s,r)=>s+r.bytes.length,0);
  const out=new Uint8Array(Math.ceil((hdr+data)/32)*32),dv=new DataView(out.buffer);
  dv.setUint32(0,N,true);let pos=hdr;
  regs.forEach((r,j)=>{const o=16*j;dv.setUint16(o+4,r.cnt,true);dv.setUint16(o+6,r.a,true);dv.setUint32(o+8,r.b,true);dv.setUint32(o+12,r.vt,true);
    dv.setUint32(16*(j+1),pos,true);out.set(r.bytes,pos);pos+=r.bytes.length});
  return out;
}
function stripify(tris){
  const key=(a,b)=>a*1048576+b,em=new Map();
  tris.forEach((t,i)=>{for(let k=0;k<3;k++){const e=key(t[k],t[(k+1)%3]);let l=em.get(e);if(!l){l=[];em.set(e,l)}l.push(i)}});
  const used=new Uint8Array(tris.length),third=(t,a,b)=>{for(let k=0;k<3;k++)if(t[k]===a&&t[(k+1)%3]===b)return t[(k+2)%3];return -1};
  const run=(i,r)=>{const t=tris[i],s=[t[r],t[(r+1)%3],t[(r+2)%3]],list=[i];used[i]=1;
    for(;;){const L=s.length,ev=(L-2)%2===0,a=ev?s[L-2]:s[L-1],b=ev?s[L-1]:s[L-2],c=em.get(key(a,b));let f=-1;
      if(c)for(const j of c)if(!used[j]){f=j;break}
      if(f<0)break;s.push(third(tris[f],a,b));list.push(f);used[f]=1}
    return {s,list}};
  const strips=[];
  for(let i=0;i<tris.length;i++){if(used[i])continue;let best=null;
    for(let r=0;r<3;r++){const x=run(i,r);x.list.forEach(j=>used[j]=0);if(!best||x.list.length>best.list.length)best=x}
    best.list.forEach(j=>used[j]=1);strips.push(best.s)}
  return strips;
}
function joinStrips(strips){
  const S=strips[0].slice();
  for(let q=1;q<strips.length;q++){const B=strips[q],n=S.length;S.push(S[n-1],B[0]);if(n%2===1)S.push(B[0]);for(const v of B)S.push(v)}
  return S;
}
function stripChain(tris){
  const K=1048576,key=(a,b)=>a*K+b,em=new Map(),bv=new Map();
  tris.forEach((t,i)=>{for(let k=0;k<3;k++){const e=key(t[k],t[(k+1)%3]);let l=em.get(e);if(!l){l=[];em.set(e,l)}l.push(i);let w=bv.get(t[k]);if(!w){w=[];bv.set(t[k],w)}w.push(i)}});
  const used=new Uint8Array(tris.length),deg=new Int32Array(tris.length);
  const NB=tris.map((t,i)=>{const r=[];for(let k=0;k<3;k++){const l=em.get(key(t[(k+1)%3],t[k]));if(l)for(const j of l)if(j!==i)r.push(j)}return r});
  NB.forEach((n,i)=>deg[i]=n.length);
  const mark=i=>{used[i]=1;for(const j of NB[i])if(!used[j])deg[j]--},unmark=i=>{used[i]=0;for(const j of NB[i])if(!used[j])deg[j]++};
  const third=(t,a,b)=>{for(let k=0;k<3;k++)if(t[k]===a&&t[(k+1)%3]===b)return t[(k+2)%3];return -1};
  const run=(i,r)=>{const t=tris[i],s=[t[r],t[(r+1)%3],t[(r+2)%3]],list=[i];mark(i);
    for(;;){const L=s.length,ev=(L-2)%2===0,a=ev?s[L-2]:s[L-1],b=ev?s[L-1]:s[L-2],c=em.get(key(a,b));let f=-1,bd=1e9;
      if(c)for(const j of c)if(!used[j]&&deg[j]<bd){bd=deg[j];f=j}
      if(f<0)break;s.push(third(tris[f],a,b));list.push(f);mark(f)}
    return {s,list}};
  let S=[],rem=tris.length;
  while(rem>0){
    let st=-1,best=null;
    if(S.length){const y=S[S.length-1],c=bv.get(y);let bd=1e9;if(c)for(const i of c)if(!used[i]&&deg[i]<bd){bd=deg[i];st=i}
      if(st>=0){best=run(st,tris[st].indexOf(y));best.list.forEach(unmark)}}
    if(!best){let bd=1e9;for(let i=0;i<tris.length;i++)if(!used[i]&&deg[i]<bd){bd=deg[i];st=i;if(bd===0)break}
      for(let r=0;r<3;r++){const x=run(st,r);x.list.forEach(unmark);if(!best||x.list.length>best.list.length)best=x}}
    best.list.forEach(mark);const B=best.s;
    if(!S.length)S=B.slice();
    else{const n=S.length,y=S[n-1];if(B[0]===y){if(n%2===1)S.push(y)}else{S.push(y,B[0]);if(n%2===1)S.push(B[0])}for(const v of B)S.push(v)}
    rem-=best.list.length}
  return S;
}
function optimize(buf,m){
  const b=new Uint8Array(buf),CAP=124,pay=[],st={vb:0,va:0,rb:0,ra:0};
  const kf=r=>r.a+'|'+r.b+'|'+r.vt,orig=(blk,r)=>({cnt:r.cnt,a:r.a,b:r.b,vt:r.vt,bytes:b.slice(blk.off+r.start,blk.off+r.start+r.cnt*r.st)});
